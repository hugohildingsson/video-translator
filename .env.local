# OpenAI API Key (för Whisper)
OPENAI_API_KEY=sk_your_key_here

# DeepL API Key (för översättning)
DEEPL_API_KEY=your_deepl_key_here

# ElevenLabs API Key (för text-till-tal)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Databaskonfiguration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/video_translator

# NextAuth Secret (för autentisering senare)
NEXTAUTH_SECRET=your_secret_key_here
